# ==============================================================================
# INNOHACK 2026 — Team Leader Portal Environment Configuration
# ==============================================================================
# Set VITE_BACKEND_MODE=firebase when connecting to your production Firebase
# project (and populate the Firebase keys below).
# Leave VITE_BACKEND_MODE=local (or unset) to run against the included local
# server-authoritative Node/Express + SSE backend for local dev & testing.

VITE_BACKEND_MODE=local

# Firebase Web App Configuration (from your existing Hackathon Live Draw project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Server / Cloud Functions Secrets (NEVER prefix with VITE_)
# Used by server/ and functions/ to HMAC-hash credentials & verify admin logins
INNOHACK_AUTH_PEPPER=innohack-2026-sliit-kandy-change-in-production
INNOHACK_SESSION_SECRET=innohack-2026-session-secret-change-in-production
INNOHACK_ADMIN_PASSCODE=INNOHACK-ADMIN-2026
